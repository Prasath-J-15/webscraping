# Elasticsearch is optional for this demo — leave these blank and the app
# still runs; ExtractionService/ScrapeService simply skip indexing (indexer=None).
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

ENVIRONMENT=development
LOG_LEVEL=INFO
INDEX_NAME=learning_scraped_items

PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_RENDER_WAIT_MS=8000
# headful is only required on Windows hosts where headless Chromium gets
# blocked by local firewall/AV rules — see core/config.py for the platform check
PLAYWRIGHT_HEADLESS=
PLAYWRIGHT_CHANNEL=

# Caps items collected per crawl so demo runs stay fast — pagination is still
# followed, collection just stops once the limit is reached.
TEST_MODE=True
TEST_MODE_JOB_LIMIT=5

BROWSER_RESTART_AFTER_PAGES=5
EMPTY_PAGE_MAX_RETRIES=3
